{
  "name": "virtual-boxer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Virtual Boxer — trening bokserski w przeglądarce, telefon jako kamera",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n web,sig -c red,blue \"vite\" \"node server/signaling.mjs\"",
    "dev:web": "vite",
    "dev:sig": "node server/signaling.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "concurrently -k -n web,sig -c red,blue \"vite preview\" \"node server/signaling.mjs\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx scripts/evaluate.ts",
    "models": "node scripts/fetch-models.mjs",
    "postinstall": "node scripts/copy-mediapipe-wasm.mjs",
    "train": "tsx scripts/train-classifier.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "ws": "8.22.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
